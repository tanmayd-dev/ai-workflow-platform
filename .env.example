# Required — get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-key

# Required — any long random string; used to sign JWTs
SECRET_KEY=change-me-to-a-long-random-string

# Optional — defaults shown; uncomment to override
#OPENROUTER_MODEL=openrouter/pony-alpha
#OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# SQLite by default; switch to postgres with: postgresql+asyncpg://user:pass@host/db
#DATABASE_URL=sqlite+aiosqlite:///./workflow_db.sqlite

# Create missing tables on app startup (local/dev default). Containers run
# `alembic upgrade head` in the entrypoint and set this to false.
#AUTO_CREATE_SCHEMA=true

# Security
#ALGORITHM=HS256
#ACCESS_TOKEN_EXPIRE_MINUTES=30

# Vector store / documents
#CHROMA_DB_DIR=./chroma_db
#EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
#DOCUMENTS_DIR=./documents

# Best-effort RAG context retrieval inside AI nodes; false = AI nodes run without context
#ENABLE_RAG=true

# --- Container (docker-compose.yml) ---------------------------------------
# Compose supplies these defaults and mounts one named volume per path:
#   DATABASE_URL=sqlite+aiosqlite:////data/db/workflow_db.sqlite
#   CHROMA_DB_DIR=/data/chroma
#   DOCUMENTS_DIR=/data/documents
# Only override them if you also adjust the volume declarations. If you set a
# local DATABASE_URL above for non-container development, keep it commented
# here or use an absolute /data/... path when running Compose.
#DATABASE_URL=sqlite+aiosqlite:////data/db/workflow_db.sqlite
#CHROMA_DB_DIR=/data/chroma
#DOCUMENTS_DIR=/data/documents

# Container-only: unprivileged UID/GID that owns the data volumes. The
# entrypoint chowns the mounted directories and drops to this user.
#APP_UID=10001
#APP_GID=10001

# Optional Postgres service (docker-compose.yml). Change the password for any
# real deployment; the app uses SQLite unless DATABASE_URL points at Postgres.
#POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-too
#POSTGRES_DB=workflow_db
